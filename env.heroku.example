# ---------------------------------------------------------------------------
# Tableau MCP on Heroku - example environment configuration
# ---------------------------------------------------------------------------

# Required for Heroku deployments
TRANSPORT=http

# OAuth protection for your MCP server (recommended)
# Set OAUTH_ISSUER to your public deployment origin (no trailing slash).
OAUTH_ISSUER=https://YOUR-APP-NAME.herokuapp.com
OAUTH_EMBEDDED_AUTHZ_SERVER=true
OAUTH_CLIENT_ID_SECRET_PAIRS=client1:secret1,client2:secret2

# One of these is required when OAuth is enabled with embedded authz server.
OAUTH_JWE_PRIVATE_KEY=
# OAUTH_JWE_PRIVATE_KEY_PATH=/app/secrets/private.pem
OAUTH_JWE_PRIVATE_KEY_PASSPHRASE=

# Optional OAuth settings
OAUTH_LOCK_SITE=true
ADVERTISE_API_SCOPES=false
OAUTH_DISABLE_SCOPES=false
OAUTH_RESOURCE_URI=https://YOUR-APP-NAME.herokuapp.com
OAUTH_REDIRECT_URI=https://YOUR-APP-NAME.herokuapp.com/Callback

# ---------------------------------------------------------------------------
# Tableau authentication mode used by MCP server when calling Tableau APIs
# Values: pat | direct-trust | uat | oauth
# ---------------------------------------------------------------------------
AUTH=direct-trust

# Required unless AUTH=oauth
SERVER=https://prod-useast-c.online.tableau.com
SITE_NAME=

# --- PAT mode ---
PAT_NAME=
PAT_VALUE=

# --- Direct Trust mode ---
JWT_SUB_CLAIM=
CONNECTED_APP_CLIENT_ID=
CONNECTED_APP_SECRET_ID=
CONNECTED_APP_SECRET_VALUE=
JWT_ADDITIONAL_PAYLOAD={}

# --- UAT mode ---
UAT_TENANT_ID=
UAT_ISSUER=
UAT_USERNAME_CLAIM_NAME=email
UAT_USERNAME_CLAIM=
UAT_PRIVATE_KEY=
# UAT_PRIVATE_KEY_PATH=/app/secrets/uat-private.pem
UAT_KEY_ID=

# ---------------------------------------------------------------------------
# HTTP server behavior
# ---------------------------------------------------------------------------
HTTP_PORT_ENV_VAR_NAME=PORT
SSL_KEY=
SSL_CERT=
CORS_ORIGIN_CONFIG=true
DISABLE_SESSION_MANAGEMENT=false

# If true, disables OAuth protection on HTTP transport (not recommended).
DANGEROUSLY_DISABLE_OAUTH=false

# ---------------------------------------------------------------------------
# Logging and runtime tuning
# ---------------------------------------------------------------------------
DEFAULT_LOG_LEVEL=debug
ENABLED_LOGGERS=appLogger
FILE_LOGGER_DIRECTORY=
DISABLE_LOG_MASKING=false
MAX_REQUEST_TIMEOUT_MS=600000

# Optional tool and site behavior
ENABLE_MCP_SITE_SETTINGS=true
MCP_SITE_SETTINGS_CHECK_INTERVAL_IN_MINUTES=10
TABLEAU_SERVER_VERSION_CHECK_INTERVAL_IN_HOURS=1
INCLUDE_TOOLS=
EXCLUDE_TOOLS=
MAX_RESULT_LIMIT=
MAX_RESULT_LIMITS=
DATASOURCE_CREDENTIALS=
DISABLE_QUERY_DATASOURCE_VALIDATION_REQUESTS=false
DISABLE_METADATA_API_REQUESTS=false

# Telemetry
TELEMETRY_PROVIDER=noop
TELEMETRY_PROVIDER_CONFIG=
LATENCY_METRIC_NAME=http_server_1agg1_request_duration
PRODUCT_TELEMETRY_ENABLED=true
